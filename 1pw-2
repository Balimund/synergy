<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Счётчик</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
    }

    .counter {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .controls {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    button {
      width: 60px;
      height: 60px;
      border: none;
      border-radius: 5px;
      background: linear-gradient(135deg, #43cea2, #185a9d);
      color: #fff;
      font-size: 32px;
      cursor: pointer;
    }

    button:disabled {
      background: linear-gradient(135deg, #bbb, #888);
      cursor: not-allowed;
      opacity: 0.7;
    }

    #result {
      min-width: 100px;
      padding: 10px 20px;
      border-radius: 5px;
      text-align: center;
      font-size: 36px;
      font-weight: bold;
      color: #222;
      background: #ff4d4d; /* стартовое значение 0 - красный */
    }

    #message {
      min-width: 320px;
      min-height: 50px;
      padding: 12px 20px;
      border-radius: 5px;
      text-align: center;
      font-size: 18px;
      color: #fff;
      background: rgba(0, 0, 0, 0.25);
    }
  </style>
</head>
<body>
  <div class="counter">
    <div class="controls">
      <button id="minus">−</button>
      <div id="result">0</div>
      <button id="plus">+</button>
    </div>
    <div id="message"></div>
  </div>

  <script>
    const MAX = 10;
    const MIN = -10;

    const resultEl = document.getElementById("result");
    const plusBtn = document.getElementById("plus");
    const minusBtn = document.getElementById("minus");
    const messageEl = document.getElementById("message");

    let count = 0;

    function render() {
      resultEl.textContent = count;

      // Цвет окна результата
      if (count > 0) {
        resultEl.style.background = "#ffd700"; // жёлтый
      } else if (count < 0) {
        resultEl.style.background = "#4caf50"; // зелёный
      } else {
        resultEl.style.background = "#ff4d4d"; // красный
      }

      // Блокировка кнопок на границах
      plusBtn.disabled = count >= MAX;
      minusBtn.disabled = count <= MIN;

      // Сообщение при экстремальных значениях
      messageEl.textContent =
        count === MAX || count === MIN
          ? "вы достигли экстремального значения"
          : "";
    }

    plusBtn.addEventListener("click", function () {
      if (count < MAX) {
        count++;
        render();
      }
    });

    minusBtn.addEventListener("click", function () {
      if (count > MIN) {
        count--;
        render();
      }
    });

    render();
  </script>
</body>
</html>
